# ==============================================================================
# Jiu-Jitsu Academy Management Platform - Environment Configuration Template
# Copy this file to .env and backend/.env for local development.
# In production (Render, Vercel, Railway), configure these variables in the provider dashboard.
# ==============================================================================

# Database Configuration (Docker Compose & Prisma)
MYSQL_DATABASE=jiujitsu_db
MYSQL_USER=jiujitsu_user
MYSQL_PASSWORD=change_this_local_mysql_password
MYSQL_ROOT_PASSWORD=change_this_local_root_password
MYSQL_PORT=3306

# Prisma Connection URL
# Local Docker: mysql://jiujitsu_user:change_this_local_mysql_password@localhost:3306/jiujitsu_db
# Cloud (e.g. Aiven): mysql://avnadmin:PASSWORD@HOST:PORT/defaultdb?ssl-mode=REQUIRED
DATABASE_URL="mysql://jiujitsu_user:change_this_local_mysql_password@localhost:3306/jiujitsu_db"

# Initial Administrator Credentials (used strictly during first seed initialization)
INITIAL_ADMIN_USERNAME=AdminDojo
INITIAL_ADMIN_EMAIL=admin@dojo.com
INITIAL_ADMIN_PASSWORD=change_this_initial_admin_password

# Backend Server Configuration
PORT=4000
JWT_SECRET=generate_a_long_random_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d
ACADEMY_TIMEZONE=Europe/Madrid

# Production CORS Origins (comma-separated, or leave empty to allow all trusted frontend origins)
# Example: CORS_ORIGINS=https://your-academy.vercel.app
CORS_ORIGINS=

# Frontend Configuration (Vercel)
# Local: http://localhost:4000/api/v1
# Production: https://your-backend-service.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
